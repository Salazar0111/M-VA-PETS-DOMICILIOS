# ─── Meta / WhatsApp Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=          # ID del número en Meta Business
WHATSAPP_ACCESS_TOKEN=             # Token de acceso permanente (Meta)
WHATSAPP_VERIFY_TOKEN=             # Token secreto que defines tú para verificar el webhook

# ─── Meta / Instagram DM API ─────────────────────────────────────────────────
INSTAGRAM_PAGE_ACCESS_TOKEN=       # Token de la página de FB vinculada a IG
INSTAGRAM_VERIFY_TOKEN=            # Token secreto para verificar el webhook de IG

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # sk-ant-...
AGENTE_MODELO=                     # Opcional. Por defecto claude-sonnet-5
AGENTE_NOMBRE=                     # Opcional. Nombre con el que se presenta. Por defecto Sara

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=               # service_role. NUNCA se expone al navegador

# ─── Google (Calendar + Maps) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=              # Del correo de MÜVA (resultadosmuva@gmail.com)
# Dejar VACÍA a propósito: los eventos van al calendario de MÜVA, no al del
# veterinario — él ve su jornada en la PWA /app/. Decisión del 2026-08-19.
GOOGLE_CALENDAR_ID_VETERINARIO=    # Si se omite usa 'primary' del correo autorizado
GOOGLE_MAPS_API_KEY=               # Geocodificación + Directions (motor de rutas)

# ─── Operación ───────────────────────────────────────────────────────────────
VETERINARIO_DIRECCION_BASE=        # Dirección donde arranca y termina la ruta diaria

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
